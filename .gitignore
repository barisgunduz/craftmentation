# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local editor state and temporary files
/.idea/
/.vscode/
*.swp
*.swo
*~

# Local environment configuration (keep shareable examples)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template

# Python verification bytecode
__pycache__/
*.pyc

# Keep lockfiles, documentation, templates, and brand assets versioned.

# Node.js dependencies and compiled output
node_modules/
/dist/
*.tgz

# Test coverage and TypeScript build cache
/coverage/
*.tsbuildinfo

# npm diagnostic logs
npm-debug.log*

# Interrupted CLI operations (never ignore shared configuration or lockfiles)
*.craftmentation.lock
*.craftmentation-*.tmp

# Original-byte recovery backups from explicit managed updates
*.craftmentation-*.bak

# Local release candidates and verification reports
/artifacts/
