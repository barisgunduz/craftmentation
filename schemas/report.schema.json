{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:craftmentation:report:v1",
  "title": "Craftmentation CLI JSON result v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "command": {
      "anyOf": [
        {
          "enum": [
            "init",
            "analyze",
            "generate",
            "update",
            "validate",
            "check",
            "doctor"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "ok",
        "invalid",
        "error"
      ]
    },
    "exitCode": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:craftmentation:analysis:v1#/$defs/diagnostic"
      }
    },
    "data": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "command",
    "status",
    "exitCode",
    "diagnostics",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "exitCode": {
            "enum": [
              2,
              3,
              4,
              5,
              6
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "analyze"
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "command",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "urn:craftmentation:analysis:v1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "init",
              "generate",
              "update"
            ]
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "command",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/changeSummary"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "validate",
              "check"
            ]
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "command",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/validationSummary"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": [
              "doctor"
            ]
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "command",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/doctorSummary"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "type": "null"
          },
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "command",
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/helpSummary"
          }
        }
      }
    }
  ],
  "$defs": {
    "changeSummary": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "urn:craftmentation:library:v1#/$defs/relativePath"
        },
        "operation": {
          "enum": [
            "create",
            "noop",
            "update"
          ]
        },
        "dryRun": {
          "type": "boolean"
        },
        "committed": {
          "type": "boolean"
        },
        "documentHash": {
          "anyOf": [
            {
              "$ref": "urn:craftmentation:library:v1#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceFingerprint": {
          "anyOf": [
            {
              "$ref": "urn:craftmentation:library:v1#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "type": "array",
          "items": {
            "$ref": "urn:craftmentation:library:v1#/$defs/sectionId"
          }
        },
        "omitted": {
          "type": "array",
          "items": {
            "$ref": "urn:craftmentation:library:v1#/$defs/sectionId"
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "urn:craftmentation:library:v1#/$defs/sectionId"
          }
        },
        "ai": {
          "type": "object"
        }
      },
      "required": [
        "path",
        "operation",
        "dryRun",
        "committed",
        "documentHash",
        "sourceFingerprint",
        "preview",
        "diff",
        "selected",
        "omitted",
        "unresolved"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dryRun": {
                "const": true
              }
            },
            "required": [
              "dryRun"
            ]
          },
          "then": {
            "properties": {
              "committed": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "validationSummary": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "urn:craftmentation:library:v1#/$defs/relativePath"
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "documentHash": {
          "$ref": "urn:craftmentation:library:v1#/$defs/sha256"
        }
      },
      "required": [
        "document",
        "errors",
        "warnings",
        "checks"
      ],
      "additionalProperties": false
    },
    "doctorSummary": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pass",
                  "warning",
                  "fail"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "check",
              "status",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "checks"
      ],
      "additionalProperties": false
    },
    "helpSummary": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  }
}
